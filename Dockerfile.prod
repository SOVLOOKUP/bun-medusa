# Production image — multi-stage build for Medusa v2 + Bun.
#
# Build:  docker build -f Dockerfile.prod -t ghcr.io/<owner>/bun-medusa:latest .
# Run:    docker run -p 9000:9000 -e DATABASE_URL=... -e REDIS_URL=... ghcr.io/<owner>/bun-medusa:latest

# ── Stage 1: Build ──────────────────────────────────────────────────
FROM oven/bun:debian AS builder

# Install git + CA certificates (needed for HTTPS git clone)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone the official Medusa v2 starter (default branch)
ARG MEDUSA_VERSION=2.18.0
ARG STARTER_REPO=https://github.com/medusajs/medusa-starter-default.git
RUN git clone --depth 1 "$STARTER_REPO" /app/medusa && \
    rm -rf /app/medusa/.git

WORKDIR /app/medusa

# Use npmmirror to avoid 429 rate-limiting from npmjs.org
ENV BUN_CONFIG_REGISTRY=https://registry.npmmirror.com

# Install ALL dependencies (Medusa v2 runs directly without a build step)
RUN bun install

# Stub out @cspotcode/source-map-support — it conflicts with Bun's native
# stack trace handling (causes "column must be >= 0" errors)
# Use ESM syntax to avoid triggering Bun's CJS detection
RUN echo 'export function install() {}; export function uninstall() {};' > \
    node_modules/@cspotcode/source-map-support/source-map-support.mjs && \
    echo '{"type":"module","main":"./source-map-support.mjs","exports":{"import":"./source-map-support.mjs","require":"./source-map-support.cjs"}}' > \
    node_modules/@cspotcode/source-map-support/package.json && \
    echo 'module.exports = { install: () => {}, uninstall: () => {} };' > \
    node_modules/@cspotcode/source-map-support/source-map-support.cjs

# ── Stage 2: Runtime ─────────────────────────────────────────────────
FROM oven/bun:debian AS runner

# Install Node.js + npm for Medusa CLI commands (Bun has CJS/ESM parsing
# issues with Medusa's config loader)
RUN apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app/medusa

# Copy built artifacts and source from builder
COPY --from=builder /app/medusa .

# Copy production entrypoint
COPY docker-entrypoint-prod.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# 9000 = Medusa backend API + Admin dashboard
EXPOSE 9000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["bun", "run", "start"]