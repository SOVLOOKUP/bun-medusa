# Medusa backend runtime configuration.
# Copy to `.env` and fill in real values before `docker compose up`.

# --- Required secrets (use strong random values in production) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
COOKIE_SECRET=change_me_to_another_long_random_string
# MFA encryption key (32+ bytes hex). Generate with: openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=change_me_to_a_long_random_hex_string

# --- CORS ---
# Frontend storefront origin(s) allowed to call the Store API.
STORE_CORS=http://localhost:8000
# Admin dashboard origin(s) allowed to call the Admin API.
ADMIN_CORS=http://localhost:5173,http://localhost:9000
# Auth API CORS (usually the union of admin + storefront origins).
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000

# --- Optional: override defaults provided in docker-compose.yml ---
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store
# REDIS_URL=redis://redis:6379
