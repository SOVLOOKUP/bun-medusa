# Medusa backend runtime configuration.
# Copy to `.env` and then `docker compose up -d --build`.
#
# ⭐ 最少配置：
#   • 只写下面的 BASE_URL 一行（dev / prod compose 都会用它推导 CORS / HMR / ADMIN_URL）
#   • 密钥留空 → 首次启动自动生成并持久化
#   • 如果用 prod compose，再填 POSTGRES_* + REDIS_* 就行

# --- 1. 公网 Origin — 写这一次（自动推导 CORS / HMR / ADMIN_URL）----------
# 本机开发直接访问 docker 端口:
BASE_URL=http://localhost:9000
# 1Panel / Nginx 反向代理到 HTTPS:
# BASE_URL=https://medusa.example.com:8443
# 标准 443 HTTPS:
# BASE_URL=https://medusa.example.com

# --- 2. 密钥（留空自动生成，填了就用填的）--------------------------------
# 生成命令: openssl rand -hex 32
# AUTH_MFA_ENCRYPTION_KEY 建议 32+ bytes hex（entrypoint 留空会直接生成 64 bytes hex）
# JWT_SECRET=
# COOKIE_SECRET=
# AUTH_MFA_ENCRYPTION_KEY=

# --- 3. CORS（通常不用写 — BASE_URL 自动推导足够）------------------------
# Admin 面板源（多个逗号分隔，无空格）
# ADMIN_CORS=http://localhost:5173,http://localhost:9000
# Storefront 源
# STORE_CORS=http://localhost:8000
# Auth 源（通常是上面两项的并集）
# AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000

# Admin 实际访问地址（BASE_URL 推导会自动赋为 <BASE_URL>/app）
# ADMIN_URL=http://localhost:9000/app

# --- 4. DATABASE + REDIS（仅 prod compose 需要填; dev compose 自带服务无需写）
# 用 docker-compose.prod.yml 时必填
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change_me_to_your_db_password
POSTGRES_HOST=postgres
POSTGRES_DB=medusa
REDIS_PASSWORD=change_me_to_your_redis_password
REDIS_HOST=redis

# 也可以直接写完整的连接串（优先级高于上面单独字段）
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store
# REDIS_URL=redis://redis:6379

# --- 5. 管理员账号（可选）------------------------------------------------
# 留空则使用 dev/prod compose 默认值 admin@medusa.local / SuperSecret123
# MEDUSA_ADMIN_EMAIL=admin@example.com
# MEDUSA_ADMIN_PASSWORD=YourStrongPassword123

# --- 6. 可选开关 ----------------------------------------------------------
# 启动时跳过自动数据库迁移（默认 true）
# MEDUSA_AUTO_MIGRATE=false

# (仅 dev compose) BASE_URL 推导出来的 HMR 不够精细时，可以单独覆盖：
# HMR_HOSTNAME=medusa.example.com
# HMR_PROTOCOL=wss
# HMR_CLIENT_PORT=8443
